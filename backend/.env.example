# App
APP_NAME=SVSP
APP_VERSION=1.0.0
DEBUG=true

# Database (PostgreSQL Neon)
DATABASE_URL=postgresql://user:password@host:5432/svsp

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS (formato ARRAY JSON obligatorio — separado por comas FALLA al arrancar)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
# En GitHub Codespaces agrega tu frontend, ej:
# CORS_ORIGINS=["http://localhost:5173", "https://TU-CODESPACE-5173.app.github.dev"]

# AdminPRO seed
ADMIN_EMAIL=admin@svsp.local
ADMIN_PASSWORD=Admin123!
ADMIN_FULL_NAME=Administrador SVSP