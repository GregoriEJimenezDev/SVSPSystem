# Copia a backend.env en el servidor (NO subir a Git) y chmod 600
APP_NAME=SVSP
DEBUG=false

# Neon: la cadena debe llevar sslmode=require
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST.neon.tech/NOMBRE_DB?sslmode=require

# Genera una con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=PEGA_AQUI_UNA_CLAVE_LARGA_Y_ALEATORIA
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Formato ARRAY JSON obligatorio
CORS_ORIGINS='["https://app.tuempresa.com"]'

# Se usa para los enlaces de los QR (reporte público y visitas). Debe ser el dominio real.
PUBLIC_BASE_URL=https://app.tuempresa.com

# AdminPRO seed (solo para seed_adminpro.py). Pon una clave fuerte.
ADMIN_EMAIL=admin@tuempresa.com
ADMIN_PASSWORD=CAMBIA_ESTA_CLAVE
ADMIN_FULL_NAME=Administrador SVSP